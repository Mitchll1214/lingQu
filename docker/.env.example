# =====================================================================
# 灵渠数据接口平台 - 部署配置模板
# 使用方法：复制为 .env 后填写，再执行 docker compose up -d --build
#   cp .env.example .env
# =====================================================================

# ==================== 外部配置库（必填）====================
# 数据库类型：mysql 或 postgresql
DB_TYPE=mysql
# 外部数据库地址：不要填 localhost（容器内 localhost 指容器自身）
# 请填宿主机可访问的地址，例如：
#   - Linux 服务器：填局域网 IP 或域名，如 192.168.1.10
#   - Docker Desktop（Mac/Windows）：可用 host.docker.internal
DB_HOST=192.168.1.10
DB_PORT=3306
# 数据库名（请先在外部库中创建，例如：CREATE DATABASE lingqu ...）
DB_NAME=lingqu
DB_USER=lingqu
DB_PASSWORD=你的数据库密码

# ==================== 可选 ====================
# AES 加密密钥：生产环境务必修改（16 字节以上随机字符串），
# 且一旦用于加密数据后不可更改，否则历史密码/Token 无法解密
AES_KEY=lingqu-aes-key-01

# 首次启动自动创建的默认管理员（登录管理后台用）
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=123456

# 端口（一般无需修改）
MANAGER_PORT=8081
EXECUTOR_PORT=8080

# 告警邮件 SMTP（不配置则告警只记日志不发送；当前支持 STARTTLS 的 25/587 端口）
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_MAIL_FROM=
ALERT_MAIL_TO=

# 容器时区
TZ=Asia/Shanghai
